# --- Subgraph dashboard config ---

# Which subgraph to show (name registered on graph-node).
SUBGRAPH_NAME=gmix-operations-prod

# index-status GraphQL (port 8030). Public endpoint works from anywhere.
GRAPH_STATUS_URL=https://graph-status.samyca.com/graphql

# Prometheus metrics (port 8040). NOT public.
#  - Local dev: open an SSH tunnel and point here at localhost:
#       ssh -i ~/.ssh/hetzner -N -L 8040:localhost:8040 root@5.78.230.148
#       GRAPH_METRICS_URL=http://localhost:8040/metrics
#  - In the VPS container (docker-compose): reach graph-node internally:
#       GRAPH_METRICS_URL=http://graph-node:8040/metrics
# Leave empty to run status-only (sync/entities/health work; rate panels show "—").
GRAPH_METRICS_URL=http://localhost:8040/metrics
