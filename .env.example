# --- Subgraph dashboard config ---
# Copy to .env (deploy) or .env.local (dev) and fill in your values.

# Optional default subgraph (used by /api/stats when no ?subgraph is given).
# Each subgraph is normally viewed at /name/<subgraph>, so this can be left empty.
SUBGRAPH_NAME=

# index-status GraphQL endpoint (graph-node port 8030).
#  - dev:    a reachable URL, e.g. https://graph-status.your-domain.com/graphql
#            or http://localhost:8030/graphql over an SSH tunnel
#  - deploy: internal service name, e.g. http://graph-node:8030/graphql
GRAPH_STATUS_URL=http://localhost:8030/graphql

# Prometheus metrics endpoint (graph-node port 8040). Not meant to be public.
#  - dev:    tunnel it ->  ssh -N -L 8040:localhost:8040 user@your-server
#            then http://localhost:8040/metrics
#  - deploy: http://graph-node:8040/metrics
# Leave empty for status-only mode (rate panels show "—").
GRAPH_METRICS_URL=http://localhost:8040/metrics

# Public hostname for the deployed dashboard (used by the Traefik router label in
# docker-compose.yml). Only needed for the VPS deploy.
DASH_HOST=subgraph-dash.your-domain.com

# Optional Traefik middleware(s) for the dashboard router (deploy only). The
# dashboard surfaces logs/entities/playground, so gating it is recommended.
# Empty = public. Example for basic auth: DASH_MIDDLEWARES=dashboard-auth@file
DASH_MIDDLEWARES=

# --- Logs tab (reads `docker logs <container>` via the Docker Engine API) ---

# graph-node container name to read logs from.
GRAPH_CONTAINER=graph-node

# How to reach the Docker Engine API.
#  - deploy: leave empty -> defaults to the unix socket /var/run/docker.sock,
#            which must be mounted read-only into the container (see compose).
#  - dev:    tunnel the remote socket to a local TCP port and point here, e.g.
#            ssh -nNT -L 2376:/var/run/docker.sock user@your-server
#            then DOCKER_HOST=http://localhost:2376
# DOCKER_HOST=

# --- Entities & Details tabs (read graph-node's Postgres directly) ---

# Read-only connection to graph-node's Postgres. Create the role first with
# scripts/setup-readonly-role.sql (see README). Leave empty to disable the
# Entities/Details tabs (they show a friendly "Postgres not configured" notice).
#  - deploy: postgresql://dash_ro:<pass>@graph-postgres:5432/graph-node  (over graphnet)
#  - dev:    tunnel the postgres container to a local port, e.g.
#            ssh -nNT -L 5433:<pg-container-ip>:5432 user@your-server
#            then postgresql://dash_ro:<pass>@localhost:5433/graph-node
# GRAPH_PG_URL=

# --- Endpoints tab (GraphQL Playground proxy) ---

# graph-node's GraphQL query endpoint (:8000). The dashboard proxies playground
# queries here server-side, so the browser never hits it directly. Empty = the
# playground is disabled. The proxy appends /subgraphs/id/<deployment>.
#  - deploy: http://graph-node:8000
#  - dev:    tunnel it ->  ssh -nNT -L 8000:localhost:8000 user@your-server
#            then GRAPH_QUERY_URL=http://localhost:8000
# GRAPH_QUERY_URL=
